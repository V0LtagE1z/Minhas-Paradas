: 1781476926:0;zsh
: 1781477662:0;python3 << 'EOF'\
import re, os\
\
home = os.environ['HOME']\
\
with open(f'{home}/.local/share/fish/fish_history') as f:\
    content = f.read()\
\
entries = re.findall(r'- cmd: (.*?)\n  when: (\d+)', content)\
\
with open(f'{home}/.zsh_history', 'a') as f:\
    for cmd, when in entries:\
        f.write(f': {when}:0;{cmd}\n')\
\
print(f'{len(entries)} comandos importados')\
EOF
